# .env.example → PLANTILLA de variables de entorno.
# Cópialo como ".env" (cp .env.example .env) y cambia los valores. El .env NUNCA se sube a GitHub
# (está en .gitignore) porque guarda contraseñas.

# ─── Servidor ───
PORT=3000
# Dirección del frontend (CORS y enlaces de los correos y del QR de rastreo)
FRONTEND_URL=http://localhost:4200

# ─── Base de datos ───
MONGO_URI=mongodb://localhost:27017/pepadeoro
# Base SOLO para las pruebas e2e (se borra en cada ejecución)
MONGO_URI_TEST=mongodb://localhost:27017/pepadeoro_test
# true solo si MongoDB corre como replica set (transacciones reales "todo o nada")
MONGO_TRANSACCIONES=false

# ─── Seguridad ───
# Secreto para firmar los tokens JWT: un texto largo y aleatorio
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio

# ─── Correo (facturas, cotizaciones, confirmaciones) ───
# prueba → NO envía: guarda cada correo como .eml en backend/correos-de-prueba/
# gmail  → envía de verdad con tu Gmail
CORREO_MODO=prueba
# Tu Gmail, desde donde salen los correos
GMAIL_USER=tucorreo@gmail.com
# Contraseña de aplicación de 16 letras (Cuenta de Google → Seguridad → Contraseñas de aplicaciones)
GMAIL_APP_PASSWORD=abcdabcdabcdabcd
# Nombre que verá el cliente como remitente
MAIL_FROM_NAME=Pepa de Oro
# SEGURIDAD: los clientes de prueba tienen correos inventados. Con esta variable TODOS los correos
# llegan a esta dirección (con el destinatario original en el asunto). Déjala vacía solo en producción.
CORREO_REDIRIGIR_A=tucorreo@gmail.com
